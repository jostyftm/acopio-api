{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "wsl.exe",
                "/usr/bin/php8.4",
                "/home/ubuntu/personal/acopio/acopio-api/artisan",
                "boost:mcp"
            ]
        }
    },
    "lsp": {
        "laravel-lsp": {
            "command": [
                "laravel-lsp"
            ],
            "extensions": [
                ".php",
                ".blade.php"
            ]
        }
    }
}